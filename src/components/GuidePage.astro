---
import "../styles/global.css";
import "../styles/refinement.css";
import "../styles/bilingual.css";
import {copy, sources} from "../data/guide";
import {TOPICS, TOPIC_GROUPS} from "../data/topics";
interface Props {lang: "id" | "en"}
const {lang}=Astro.props;
const c=copy[lang]; const en=lang==='en';
const origin=Astro.site || new URL('https://jakartahistory.com');
const absolute=(path:string)=>new URL(path,origin).href;
const home=en?'/en/':'/';const alternate=en?'/':'/en/';
const museumImage='/images/jakarta-history-museum.jpg';const squareImage='/images/fatahillah-square.jpg';
const ids=['museum','hours','tickets','history','access','maps','faq'];
const museumSchema={"@context":"https://schema.org","@type":"Museum",name:"Museum Sejarah Jakarta",alternateName:["Jakarta History Museum","Museum Fatahillah"],url:absolute(home),description:c.description,image:absolute(museumImage),hasMap:sources.maps,address:{"@type":"PostalAddress",streetAddress:"Taman Fatahillah No. 1, Pinangsia, Taman Sari",addressLocality:"Jakarta Barat",addressRegion:"DKI Jakarta",postalCode:"11110",addressCountry:"ID"},geo:{"@type":"GeoCoordinates",latitude:-6.1351828,longitude:106.8133498}};
const faqSchema={"@context":"https://schema.org","@type":"FAQPage",mainEntity:c.faq.map(f=>({"@type":"Question",name:f.q,acceptedAnswer:{"@type":"Answer",text:f.a}}))};
const sourceUrls=[sources.registry,sources.culture,sources.opening,sources.older,sources.maps];
const stripHtml=(s:string)=>s.replace(/<[^>]+>/g," ").replace(/\s+/g," ").trim();
const guideLinks=TOPIC_GROUPS.map((g)=>({label:en?g.enLabel:g.idLabel,items:TOPICS.filter((t)=>t.group===g.id).map((t)=>{const href=en?`/en/${t.en.slug}/`:`/${t.id.slug}/`;return {href,linkText:stripHtml(t[lang].h1),title:t[lang].title};})}));
---
<!doctype html><html lang={lang}><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{c.title}</title><meta name="description" content={c.description}/><meta name="theme-color" content="#103C35"/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="manifest" href="/site.webmanifest"/>
<link rel="canonical" href={absolute(home)}/><link rel="alternate" hreflang="id" href={absolute('/')}/><link rel="alternate" hreflang="en" href={absolute('/en/')}/><link rel="alternate" hreflang="x-default" href={absolute('/')}/>
<meta property="og:type" content="website"/><meta property="og:title" content={c.title}/><meta property="og:description" content={c.description}/><meta property="og:url" content={absolute(home)}/><meta property="og:image" content={absolute(museumImage)}/><meta property="og:locale" content={en?'en_US':'id_ID'}/>
<script is:inline type="application/ld+json" set:html={JSON.stringify(museumSchema)}/><script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}/>
</head><body>
<a class="skip-link" href="#content">{en?'Skip to main content':'Lewati ke isi utama'}</a>
<header class="site-header"><a class="brand" href="#home"><span><strong>Museum Sejarah Jakarta</strong><small>{en?'Independent Kota Tua guide':'Panduan independen Kota Tua'}</small></span></a><nav aria-label={en?'Main navigation':'Navigasi utama'}>{ids.map((id,i)=><a href={`#${id}`}>{c.nav[i]}</a>)}</nav><div class="header-actions"><a class="language-switch" href={alternate} lang={en?'id':'en'}>{c.lang}</a></div></header>
<main id="content">
<section id="home" class="hero"><div class="hero-photo" style={`background-image:linear-gradient(90deg,rgba(9,35,31,.9),rgba(9,35,31,.55),rgba(9,35,31,.16)),url(${museumImage});`}></div><div class="hero-content"><p class="eyebrow light">KOTA TUA · JAKARTA · INDONESIA</p><h1 set:html={c.hero}/><p class="hero-lede">{c.lead}</p><div class="hero-actions"><a class="button primary" href="#hours">{c.plan} ↓</a><a class="text-link light" href="#maps">{c.map} ↘</a></div></div></section>
<section id="museum" class="section intro-section"><div class="route-number">01 / MUSEUM & TAMAN FATAHILLAH</div><div class="intro-layout"><h2 set:html={c.museumTitle}/><div class="copy-block"><p>{c.museumText}</p><p>{c.squareText}</p><a class="text-link" href={sources.culture}>{c.labels[1]} ↗</a></div></div><div class="place-selector-grid"><figure class="photo-card"><img src={museumImage} alt={en?'Jakarta History Museum in the former city hall':'Museum Sejarah Jakarta di bangunan balai kota lama'} width="1920" height="1046" loading="lazy"/><figcaption>Museum Sejarah Jakarta · CEphoto, Uwe Aranas · <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a></figcaption></figure><figure class="photo-card"><img src={squareImage} alt={en?'Fatahillah Square outside Jakarta History Museum':'Taman Fatahillah di luar Museum Sejarah Jakarta'} width="1920" height="1440" loading="lazy"/><figcaption>Taman Fatahillah · Chainwit. · <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a></figcaption></figure></div></section>
<section id="hours" class="section visit-section"><div class="route-number light">02 / {c.nav[1]}</div><div class="visit-heading"><h2 set:html={c.hoursTitle}/><p>{c.hoursNote}</p></div><div class="visit-cards"><article><span>01</span><h3>{en?'National museum registry':'Registri museum nasional'}</h3><p>{c.officialHours}</p><a class="text-link" href={sources.registry}>{en?'View source':'Lihat sumber'} ↗</a></article><article><span>02</span><h3>Google Maps & {en?'older database':'pangkalan data lama'}</h3><p>{c.mapHours}</p><a class="text-link" href={sources.maps}>Google Maps ↗</a> · <a class="text-link" href={sources.older}>{en?'Cultural database':'Pangkalan data budaya'} ↗</a></article></div></section>
<section id="tickets" class="section intro-section"><div class="route-number">03 / {c.nav[2]}</div><div class="intro-layout"><h2 set:html={c.ticketsTitle}/><div class="copy-block"><p>{c.ticketsText}</p><p>{c.ticketsNote}</p><a class="text-link" href={sources.registry}>{c.labels[0]} ↗</a></div></div></section>
<section id="history" class="section museum-section"><div class="route-number">04 / {c.nav[3]}</div><div class="museum-layout"><h2 set:html={c.historyTitle}/><div class="copy-block"><p>{c.historyText}</p><p>{c.historyNote}</p><p><a class="text-link" href={sources.opening}>{c.labels[2]} ↗</a></p></div></div></section>
<section id="access" class="section access-section"><div class="route-number">05 / {c.nav[4]}</div><div class="access-heading"><h2 set:html={c.accessTitle}/><div><p>{c.accessText}</p><p>{c.services}</p><p>{c.phone}: <a class="text-link" href="tel:+62216929101">+62 21 692 9101</a>.</p></div></div></section>
<section id="maps" class="section map-section"><div class="route-number light">06 / {c.nav[5]}</div><div class="map-heading"><div><h2>Museum Sejarah Jakarta</h2><p>{c.address}</p><p>{c.snapshot}</p></div><a class="button coral" href={sources.maps} target="_blank" rel="noreferrer">{c.map} ↗</a></div><div class="map-frame"><iframe src="https://maps.google.com/maps?q=-6.1351828,106.8133498&z=17&output=embed" title={en?'Jakarta History Museum location':'Lokasi Museum Sejarah Jakarta'} width="600" height="450" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></section>
<section id="faq" class="section faq-section"><div class="route-number">07 / FAQ</div><div class="faq-heading"><h2 set:html={c.faqTitle}/></div><div class="faq-list">{c.faq.map(f=><details><summary>{f.q}<span>+</span></summary><p>{f.a}</p></details>)}</div></section>
<section class="section transparency-section"><div class="route-number light">08 / {en?'SOURCES':'SUMBER'}</div><div class="transparency-layout"><div><h2 set:html={c.sourcesTitle}/><p>{c.sourceNote}</p></div><ul>{sourceUrls.map((url,i)=><li><a href={url}>{c.labels[i]} ↗</a></li>)}<li><a href="https://commons.wikimedia.org/wiki/File:Jakarta_Indonesia_Jakarta-History-Museum-01.jpg">{en?'Museum photo':'Foto museum'} · CEphoto, Uwe Aranas · CC BY-SA 3.0 ↗</a></li><li><a href="https://commons.wikimedia.org/wiki/File:Batavia_City_Hall_(Jakarta_History_Museum)_Fatahillah_Square_(2025)_-_img_17.jpg">{en?'Square photo':'Foto lapangan'} · Chainwit. · CC BY 4.0 ↗</a></li></ul></div></section>
<section class="section guides-section"><div class="route-number light">{en ? "GUIDES" : "PANDUAN"}</div><div class="guides-wrap">{guideLinks.map((g) => (<div class="guide-group"><h3>{g.label}</h3><ul>{g.items.map((it) => <li><a href={it.href} title={it.title}>{it.linkText}</a></li>)}</ul></div>))}</div></section>
</main><footer class="site-footer"><div class="footer-top"><div class="brand"><strong>Museum Sejarah Jakarta</strong></div><p>{c.independent}</p></div><div class="footer-bottom"><span>© 2026 Jakarta History Visitor Guide</span><div><a href={`${home}privacy/`}>{c.legal[0]}</a><a href={`${home}terms/`}>{c.legal[1]}</a><a href={`${home}cookie-settings/`}>{c.legal[2]}</a></div></div></footer>
</body></html>
