---
import PolicyLayout from "../../layouts/PolicyLayout.astro";
---
<PolicyLayout lang="en" title="Cookie Settings" eyebrow="YOUR CHOICE" summary="Manage essential storage and analytics consent for this guide." alternateHref="/cookie-settings/" alternateLabel="ID" homeHref="/en/" homeLabel="Back to guide" privacyHref="/en/privacy/" privacyLabel="Privacy Policy" termsHref="/en/terms/" termsLabel="Terms" cookieHref="/en/cookie-settings/" cookieLabel="Cookie Settings">
  <section><h2>Essential <em>storage.</em></h2><p>Essential Cookie or storage keeps basic choices, including your Cookie preference. It is always active and is not used for advertising.</p><div class="policy-choice"><div><strong>Essential preferences</strong><span>Always active for basic site functions.</span></div><span>ACTIVE</span></div></section>
  <section><h2>Analytics <em>Cookies.</em></h2><p>If you agree, Google Analytics may help us understand aggregate use of the guide. Consent is optional and can be changed at any time.</p><div class="policy-choice"><div><strong>Google Analytics</strong><span>Anonymous usage information used to improve content.</span></div><button class="button coral" data-accept>Allow analytics</button></div><div class="policy-choice"><div><strong>No analytics</strong><span>You can still use every part of this guide.</span></div><button class="button outline-policy" data-reject>Reject analytics</button></div></section>
  <section><p class="policy-note" data-status>Loading your choice…</p></section>
  <script is:inline>const status=document.querySelector('[data-status]');const render=()=>{const value=localStorage.getItem('fatahillah-analytics');status.textContent=value==='accepted'?'Analytics are allowed. You can change your choice at any time.':value==='rejected'?'Analytics are not allowed. Your choice has been saved.':'No analytics choice has been saved yet.'};document.querySelector('[data-accept]').addEventListener('click',()=>{localStorage.setItem('fatahillah-analytics','accepted');render()});document.querySelector('[data-reject]').addEventListener('click',()=>{localStorage.setItem('fatahillah-analytics','rejected');render()});render();</script>
</PolicyLayout>
