---
import TopicPage from "../../components/TopicPage.astro";
import { TOPICS } from "../../data/topics";

export function getStaticPaths() {
  return TOPICS.map((t) => ({
    params: { topic: t.en.slug },
    props: { key: t.key, lang: "en" as const },
  }));
}

interface Props {
  key: string;
  lang: "id" | "en";
}
const { key, lang } = Astro.props;
---
<TopicPage key={key} lang={lang} />
