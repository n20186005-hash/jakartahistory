---
// Batu & Sepeda — editorial travel guide: stone-square warmth, patina green, and Merah Ontel anchors.
import "../styles/global.css";
import "../styles/refinement.css";
import "../styles/bilingual.css";

const site = Astro.site?.toString().replace(/\/$/, "") || "";
const absolute = (path: string) => (site ? `${site}${path}` : path);
const canonical = absolute("/");
const heroImage = "https://commons.wikimedia.org/wiki/Special:FilePath/Jakarta%20Indonesia%20Jakarta-History-Museum-01.jpg?width=1600";
const squareImage = "https://commons.wikimedia.org/wiki/Special:FilePath/Batavia%20City%20Hall%20%28Jakarta%20History%20Museum%29%20Fatahillah%20Square%20%282025%29%20-%20img%2017.jpg?width=1200";

const attractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  name: "Taman Fatahillah",
  alternateName: "Lapangan Fatahillah",
  description: "Ruang publik di pusat Kota Tua Jakarta, di depan bekas Balai Kota Batavia.",
  url: canonical,
  image: absolute(heroImage),
  address: {
    "@type": "PostalAddress",
    streetAddress: "Jl. Lada Dalam No.7, RT.7/RW.7, Pinangsia",
    addressLocality: "Kota Jakarta Barat",
    addressRegion: "Daerah Khusus Ibukota Jakarta",
    postalCode: "11110",
    addressCountry: "ID"
  },
  geo: { "@type": "GeoCoordinates", latitude: -6.134920560150956, longitude: 106.81070202690715 },
  openingHours: "Mo-Su 00:00-23:59",
  isAccessibleForFree: true,
  aggregateRating: { "@type": "AggregateRating", ratingValue: "4.6", reviewCount: "29928", bestRating: "5" }
};

const museumSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Museum Sejarah Jakarta",
  alternateName: "Jakarta History Museum",
  address: attractionSchema.address,
  geo: { "@type": "GeoCoordinates", latitude: -6.135177460153231, longitude: 106.81077487690717 },
  openingHoursSpecification: [
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Tuesday", "Wednesday", "Thursday", "Friday"], opens: "09:00", closes: "15:00" },
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Saturday", "Sunday"], opens: "09:00", closes: "20:00" }
  ],
  aggregateRating: { "@type": "AggregateRating", ratingValue: "4.6", reviewCount: "22874", bestRating: "5" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", name: "Apakah masuk ke Taman Fatahillah berbayar?", acceptedAnswer: { "@type": "Answer", text: "Taman Fatahillah adalah ruang publik dan umumnya dapat diakses tanpa tiket. Kegiatan, layanan, atau acara di sekitarnya dapat memiliki ketentuan sendiri." } },
    { "@type": "Question", name: "Kapan waktu yang nyaman untuk datang?", acceptedAnswer: { "@type": "Answer", text: "Pagi atau sore biasanya lebih nyaman untuk berjalan kaki dan memotret. Aktivitas sewa sepeda dan pertunjukan jalanan paling mudah ditemui pada siang hingga menjelang sore." } },
    { "@type": "Question", name: "Bagaimana menuju Taman Fatahillah dari bandara?", acceptedAnswer: { "@type": "Answer", text: "Dari Bandara Internasional Soekarno-Hatta, pertimbangkan taksi resmi, kendaraan sewa, atau transportasi daring menuju Kota Tua. Untuk transportasi publik, periksa rute dan jadwal yang berlaku sebelum berangkat." } },
    { "@type": "Question", name: "Apakah tersedia parkir, toilet, dan tempat makan?", acceptedAnswer: { "@type": "Answer", text: "Ketersediaan parkir serta toilet mengikuti pengelolaan kawasan dan dapat berubah. Di sekitar Kota Tua tersedia kategori usaha makan, kebutuhan ringan, dan layanan perjalanan; pilih sesuai kebutuhan tanpa mengandalkan rekomendasi merek." } }
  ]
};
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Panduan independen untuk membaca suasana, akses, dan kunjungan ke Taman Fatahillah di Kota Tua Jakarta." />
    <meta name="theme-color" content="#103C35" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    {site && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content="Taman Fatahillah — Panduan Kota Tua Jakarta" />
    <meta property="og:description" content="Panduan independen untuk membaca suasana, akses, dan kunjungan ke Taman Fatahillah." />
    <meta property="og:image" content={absolute(heroImage)} />
    {site && <meta property="og:url" content={canonical} />}
    <title>Taman Fatahillah — Panduan Kota Tua Jakarta</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(museumSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#isi">Lewati ke isi utama</a>
    <header class="site-header" data-header>
      <a class="brand" href="#beranda" aria-label="Kembali ke awal panduan">
        <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true"><path d="M12 43h40M19 40l8-15h10l8 15M23 43a6 6 0 1 1 0 12 6 6 0 0 1 0-12Zm18 0a6 6 0 1 1 0 12 6 6 0 0 1 0-12Z" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M27 25 22 17h9l6 8" fill="none" stroke="#B7472A" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span><strong>Taman Fatahillah</strong><small>Panduan Kota Tua</small></span>
      </a>
      <nav aria-label="Navigasi utama">
        <a href="#cerita">Cerita</a><a href="#kunjungan">Kunjungan</a><a href="#akses">Akses</a><a href="#peta">Peta</a><a href="#tanya-jawab">FAQ</a>
      </nav>
      <div class="header-actions"><a class="language-switch" href="/en/" lang="en">EN</a><a class="header-cta" href="#kunjungan">Rencanakan kunjungan <span>↘</span></a></div>
    </header>

    <main id="isi">
      <section id="beranda" class="hero">
        <div class="hero-photo" style={`background-image: linear-gradient(90deg, rgba(9,35,31,.91) 0%, rgba(9,35,31,.62) 44%, rgba(9,35,31,.19) 100%), url(${heroImage});`}></div>
        <div class="hero-route"></div>
        <div class="hero-stamp" aria-label="Kota Tua Jakarta"><span>Kota Tua</span><b>Jakarta</b><i>•</i><span>Ruang Publik</span></div>
        <div class="hero-content">
          <p class="eyebrow light">Kota Tua · Jakarta, Indonesia</p>
          <h1>Taman<br /><em>Fatahillah</em></h1>
          <p class="hero-lede">Lapangan batu di jantung Kota Tua—tempat arsitektur lama, sepeda ontel, dan ritme kota bertemu dalam satu ruang terbuka.</p>
          <div class="hero-actions"><a class="button primary" href="#kunjungan">Atur kunjungan <span>→</span></a><a class="text-link light" href="#cerita">Baca cerita lapangan <span>↓</span></a></div>
        </div>
        <div class="hero-meta"><span>01 / RUANG TERBUKA</span><span>-6.134921, 106.810702</span></div>
      </section>

      <section id="pilih-tempat" class="section place-selector-section">
        <div class="route-number">01A <span>/ DUA TEMPAT, DUA CARA BERKUNJUNG</span></div>
        <div class="selector-heading"><h2>Pilih ritme<br /><em>kunjungan Anda.</em></h2><p>Di satu sisi ada lapangan terbuka untuk suasana Kota Tua; di sisi lain ada museum dalam ruang untuk membaca perjalanan Jakarta. Keduanya berhadapan, tetapi pengalaman dan ketentuannya berbeda.</p></div>
        <div class="place-selector-grid">
          <article class="place-card"><img src={squareImage} alt="Taman Fatahillah dan fasad bersejarah Kota Tua" loading="lazy" /><div class="place-card-body"><p class="eyebrow">01 / LUAR RUANG</p><h3>Taman Fatahillah</h3><p>Lapangan publik, sepeda ontel, aktivitas jalanan, dan fasad Kota Tua.</p><div><a class="text-link" href="#kunjungan">Lihat panduan lapangan <span>→</span></a><a class="map-mini-link" href="https://maps.app.goo.gl/5h3gQRZc4fwgGoU97" target="_blank" rel="noreferrer">Peta lapangan ↗</a></div></div></article>
          <article class="place-card museum-card"><img src={heroImage} alt="Museum Sejarah Jakarta, bekas Balai Kota Batavia" loading="lazy" /><div class="place-card-body"><p class="eyebrow">02 / DALAM RUANG</p><h3>Museum Sejarah Jakarta</h3><p>Koleksi sejarah, ruang sidang, arsitektur bekas balai kota, dan penjara bawah tanah.</p><div><a class="text-link" href="#museum-info">Lihat panduan museum <span>→</span></a><a class="map-mini-link" href="https://maps.app.goo.gl/XaSitKkU9B9Wd5Lf6" target="_blank" rel="noreferrer">Peta museum ↗</a></div></div></article>
        </div>
      </section>

      <section id="cerita" class="section intro-section">
        <div class="route-number">01 <span>/ SEKILAS</span></div>
        <div class="intro-layout">
          <h2>Bukan sekadar<br /><em>latar berfoto.</em></h2>
          <div class="copy-block"><p>Taman Fatahillah adalah bekas <i>Stadhuisplein</i>, alun-alun yang dahulu berada di depan Balai Kota Batavia. Kini, lapangan ini menjadi ruang publik yang menyatukan pejalan kaki, pertunjukan budaya, kegiatan komunitas, dan bangunan-bangunan bersejarah Kota Tua.</p><p>Datanglah untuk mengamati ruangnya perlahan. Batu-batu lapangan, fasad putih di sekelilingnya, dan lalu-lintas orang menawarkan cara sederhana untuk memahami sejarah Jakarta yang masih dipakai sehari-hari.</p><a class="text-link" href="https://www.indonesia.travel/id/id/travel-ideas/heritage/explore-jakarta-kota-tua-today-s-old-batavia" target="_blank" rel="noreferrer">Buka rujukan pariwisata Indonesia <span>↗</span></a></div>
        </div>
        <div class="facts-strip">
          <article><span class="fact-symbol">◎</span><p>IDENTITAS</p><h3>Ruang publik Kota Tua</h3><small>Bekas alun-alun di depan Balai Kota Batavia.</small></article>
          <article><span class="fact-symbol">◌</span><p>RATING PETA</p><h3>4,6 / 5</h3><small>Nilai pihak ketiga; dapat berubah sewaktu-waktu.</small></article>
          <article><span class="fact-symbol">↻</span><p>BIAYA MASUK</p><h3>Tanpa tiket</h3><small>Lapangan bersifat terbuka; layanan lain dapat berbeda.</small></article>
          <article><span class="fact-symbol">◷</span><p>JAM LAPANGAN</p><h3>24 jam</h3><small>Aktivitas kawasan lebih ramai pada waktu siang.</small></article>
        </div>
      </section>

      <section class="section rhythm-section">
        <div class="route-number">02 <span>/ RITME LAPANGAN</span></div>
        <div class="rhythm-grid">
          <figure class="photo-card square-photo"><img src={squareImage} alt="Fasad bekas Balai Kota Batavia di sisi Taman Fatahillah" loading="lazy" /><figcaption>Bangunan-bangunan di tepi lapangan membentuk orientasi visual Kota Tua.</figcaption></figure>
          <div class="rhythm-copy"><p class="eyebrow">Pengalaman luar ruang</p><h2>Rasakan Kota Tua<br /><em>dari pelan-pelan.</em></h2><p>Di siang hari, sepeda ontel berwarna-warni, topi lebar, seniman jalanan, dan pertunjukan dadakan menambah lapisan sosial di lapangan. Sore hari memberi cahaya yang lebih lunak untuk berjalan dan memotret fasad.</p><p>Sepeda dan aktivitas jalanan adalah pengalaman kawasan, bukan pengganti informasi keselamatan. Gunakan area yang diizinkan, sepakati biaya lebih dulu bila memakai layanan lokal, dan tetap perhatikan jalur pejalan kaki.</p></div>
        </div>
      </section>

      <section id="kunjungan" class="section visit-section">
        <div class="route-number light">03 <span>/ KUNJUNGAN</span></div>
        <div class="visit-heading"><h2>Datang untuk<br /><em>mengamati, bukan terburu.</em></h2><p>Taman Fatahillah bekerja paling baik sebagai titik awal yang dapat disambungkan ke museum, bangunan warisan, dan jalur pejalan kaki di Kota Tua.</p></div>
        <div class="visit-cards">
          <article><span>A / WAKTU</span><h3>Pagi atau selepas sore</h3><p>Pertimbangkan pagi sebelum cuaca menghangat, atau sore ketika lapangan terasa lebih teduh. Cuaca, acara, dan tingkat keramaian dapat berubah.</p></article>
          <article><span>B / DURASI</span><h3>45–90 menit</h3><p>Cukup untuk berkeliling lapangan, mengamati suasana, memotret, dan menyusun langkah berikutnya. Tambahkan waktu bila mengikuti kegiatan budaya.</p></article>
          <article><span>C / ETIKA RUANG</span><h3>Berjalan dengan peka</h3><p>Jaga jalur pejalan kaki, hindari menghalangi seniman atau kegiatan komunitas, dan ikuti penanda keselamatan serta arahan petugas di lokasi.</p></article>
        </div>
      </section>

      <section id="museum" class="section museum-section">
        <div class="route-number">04 <span>/ KUNJUNGAN PENDAMPING</span></div>
        <div class="museum-layout"><div><p class="eyebrow">Di seberang lapangan</p><h2>Masuk ke dalam<br /><em>sejarah Batavia.</em></h2><p>Setelah menikmati ruang terbuka, Museum Sejarah Jakarta di bekas <i>Stadhuis van Batavia</i> memberi konteks yang berbeda: koleksi perjalanan Jakarta, furnitur, peta, ruang sidang, dan penjara bawah tanah.</p><p>Ini adalah kunjungan dalam ruang dengan jam layanan serta tiket tersendiri. Jangan menyamakan jam dan biaya museum dengan akses ke lapangan.</p><a class="text-link" href="https://maps.app.goo.gl/XaSitKkU9B9Wd5Lf6" target="_blank" rel="noreferrer">Buka titik Museum Sejarah Jakarta <span>↗</span></a></div><aside class="museum-note"><p>Jam rujukan</p><strong>Selasa–Jumat<br />09.00–15.00 WIB</strong><strong>Sabtu–Minggu<br />09.00–20.00 WIB</strong><strong>Senin<br />Tutup</strong><small>Rujuk Indonesia Travel sebelum berangkat; informasi layanan dapat berubah.</small></aside></div>
        <div id="museum-info" class="museum-info-grid"><article><span>01</span><h3>Tiket & biaya</h3><p>Masuk museum memerlukan tiket. Rujukan Indonesia Travel mencantumkan tarif WNI dewasa Rp15.000, pelajar/mahasiswa Rp5.000, dan WNA Rp50.000. Konfirmasikan tarif di kanal resmi sebelum berangkat.</p></article><article><span>02</span><h3>Durasi & alur</h3><p>Siapkan sekitar 60–120 menit untuk membaca koleksi utama, melihat ruang sidang, dan mengunjungi penjara bawah tanah. Datang lebih awal membantu memberi waktu untuk pengalaman dalam ruang.</p></article><article><span>03</span><h3>Akses & layanan</h3><p>Gunakan titik museum pada peta bila tiba dengan taksi atau transportasi daring. Parkir, toilet, makanan, dan kebutuhan ringan bergantung pada pengaturan kawasan Kota Tua; konfirmasikan saat tiba.</p></article><article><span>04</span><h3>Fokus kunjungan</h3><p>Jelajahi cerita Jakarta dari Sunda Kelapa, Jayakarta, hingga Batavia melalui artefak, peta, dan jejak administrasi kota. Hormati ketentuan ruang koleksi serta petunjuk petugas.</p></article></div>
      </section>

      <section id="akses" class="section access-section">
        <div class="route-number">05 <span>/ AKSES & ORIENTASI</span></div>
        <div class="access-heading"><h2>Bergerak di kota,<br /><em>bukan mengejar jadwal.</em></h2><p>Gunakan Taman Fatahillah atau alamat Jl. Lada Dalam sebagai tujuan. Cek keadaan rute pada hari perjalanan, terutama pada akhir pekan atau ketika terdapat kegiatan kawasan.</p></div>
        <ol class="access-list"><li><span>01</span><div><h3>Dari bandara</h3><p>Dari Bandara Internasional Soekarno-Hatta, pilihan paling langsung adalah taksi resmi, kendaraan sewa, atau transportasi daring menuju Kota Tua. Untuk pilihan kereta dan layanan lanjutan, periksa koneksi serta jam operasi aktual sebelum berangkat.</p></div></li><li><span>02</span><div><h3>KRL, TransJakarta, dan MRT</h3><p>Kota Tua berdekatan dengan Stasiun Jakarta Kota dan dapat dicapai melalui jaringan KRL serta layanan bus atau angkutan lanjutan. Turunlah di titik yang sesuai dengan rute hari itu, lalu lanjutkan berjalan kaki dengan memperhatikan arus pejalan kaki.</p></div></li><li><span>03</span><div><h3>Taksi dan transportasi daring</h3><p>Masukkan nama taman atau alamat lengkap sebagai tujuan. Titik jemput dan arus kendaraan dapat berubah saat kawasan ramai; ikuti lokasi yang ditetapkan aplikasi atau petugas.</p></div></li><li><span>04</span><div><h3>Kendaraan pribadi</h3><p>Ikuti rambu, rekayasa lalu lintas, serta area parkir resmi. Jangan mengandalkan bahu jalan atau ruang pejalan kaki sebagai tempat parkir, terutama saat akhir pekan dan acara publik.</p></div></li></ol>
        <div class="service-grid"><article><span>↗</span><h3>Parkir</h3><p>Gunakan lokasi resmi dan periksa kapasitas setibanya di kawasan.</p></article><article><span>⌂</span><h3>Toilet</h3><p>Konfirmasikan ketersediaan fasilitas saat tiba; lokasi dapat berubah.</p></article><article><span>✦</span><h3>Makan & minum</h3><p>Cari kategori makanan Indonesia, kedai, atau makanan ringan sesuai kebutuhan Anda.</p></article><article><span>▣</span><h3>Kebutuhan perjalanan</h3><p>Temukan toko kebutuhan ringan, ATM, apotek, atau minimarket di koridor kota sesuai rute.</p></article><article><span>▤</span><h3>Akomodasi</h3><p>Pilih kategori penginapan di pusat kota berdasarkan kebutuhan akses, anggaran, dan jadwal Anda.</p></article><article><span>ϟ</span><h3>Bahan bakar & pengisian</h3><p>Rencanakan sebelum masuk jam ramai; fasilitas bergantung pada rute kendaraan.</p></article></div>
      </section>

      <section class="section surroundings-section">
        <div class="route-number">06 <span>/ DI SEKITAR KOTA TUA</span></div>
        <div class="surroundings-heading"><h2>Perpanjang hari<br /><em>dengan konteks.</em></h2><p>Bagian ini memberi arah eksplorasi, bukan rekomendasi merek atau usaha tertentu. Periksa jam layanan, akses, dan kebijakan lokasi sebelum menyusun rute.</p></div>
        <div class="surroundings-grid"><article><span>01</span><h3>Makanan lokal</h3><p>Di koridor Kota Tua, Anda dapat mencari makanan jalanan Indonesia seperti kerak telor, rumah makan sederhana, atau kedai minum sesuai preferensi dan kondisi diet.</p></article><article><span>02</span><h3>Museum & warisan</h3><p>Di sekitar lapangan terdapat museum bertema sejarah, wayang, seni rupa, keramik, serta jejak arsitektur kota. Jadikan tiap museum sebagai kunjungan tersendiri.</p></article><article><span>03</span><h3>Jalur kota lama</h3><p>Perpanjang langkah ke arah bangunan bersejarah, kanal, dan koridor pedestrian Kota Tua pada siang hari sambil memerhatikan keamanan pribadi dan cuaca.</p></article><article><span>04</span><h3>Sunda Kelapa</h3><p>Untuk konteks maritim, rencanakan kunjungan terpisah ke kawasan pelabuhan lama. Jarak, kondisi cuaca, dan akses tidak sama dengan lapangan.</p></article></div>
      </section>

      <section id="peta" class="section map-section">
        <div class="route-number light">07 <span>/ LOKASI</span></div>
        <div class="map-heading"><div><h2>Dua titik untuk<br /><em>menemukan arah.</em></h2><p>Keduanya berada di Kota Tua Jakarta, tetapi gunakan nama tujuan yang tepat agar pengemudi dan rute Anda sesuai dengan jenis kunjungan yang direncanakan.</p></div></div>
        <div class="map-grid"><article class="map-card"><div class="map-card-heading"><div><p class="eyebrow">01 / LAPANGAN</p><h3>Taman Fatahillah</h3><p>Jl. Lada Dalam No.7, Pinangsia, Taman Sari.</p></div><a class="button coral" href="https://maps.app.goo.gl/5h3gQRZc4fwgGoU97" target="_blank" rel="noreferrer">Buka peta <span>↗</span></a></div><div class="map-frame"><iframe title="Peta Taman Fatahillah" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6854.384557396718!2d106.81070202690715!3d-6.134920560150956!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e6a1dff3f8f5fed%3A0xf2536e698fceab32!2sTaman%20Fatahillah!5e1!3m2!1sid!2sid!4v1787021134348!5m2!1sid!2sid" width="600" height="450" style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></article><article class="map-card"><div class="map-card-heading"><div><p class="eyebrow">02 / MUSEUM</p><h3>Museum Sejarah Jakarta</h3><p>Taman Fatahillah No.1, Pinangsia, Taman Sari.</p></div><a class="button coral" href="https://maps.app.goo.gl/XaSitKkU9B9Wd5Lf6" target="_blank" rel="noreferrer">Buka peta <span>↗</span></a></div><div class="map-frame"><iframe title="Peta Museum Sejarah Jakarta" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6854.3812539333985!2d106.81077487690717!3d-6.135177460153231!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e6a1dff4292a57d%3A0x12f0032d678c0745!2sJakarta%20History%20Museum!5e1!3m2!1sid!2sid!4v1787020766802!5m2!1sid!2sid" width="600" height="450" style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></article></div>
      </section>

      <section id="tanya-jawab" class="section faq-section">
        <div class="route-number">08 <span>/ PERTANYAAN UMUM</span></div>
        <div class="faq-heading"><h2>Sebelum<br /><em>melangkah.</em></h2><p>Jawaban ini adalah orientasi awal. Untuk acara, akses, kondisi layanan, atau perubahan mendadak, periksa sumber resmi menjelang kunjungan.</p></div>
        <div class="faq-list"><details><summary>Apakah masuk ke Taman Fatahillah berbayar?<span>+</span></summary><p>Taman Fatahillah adalah ruang publik dan umumnya dapat diakses tanpa tiket. Kegiatan, layanan, atau acara di sekitarnya dapat memiliki ketentuan sendiri.</p></details><details><summary>Apakah Museum Sejarah Jakarta memerlukan tiket?<span>+</span></summary><p>Ya. Museum adalah kunjungan dalam ruang dengan tiket dan jam layanan tersendiri. Rujuk kanal resmi untuk mengonfirmasi tarif, jam operasional, dan akses sebelum berangkat.</p></details><details><summary>Kapan waktu yang nyaman untuk datang?<span>+</span></summary><p>Pagi atau sore biasanya lebih nyaman untuk lapangan. Untuk museum, pertimbangkan datang pada awal jam buka agar punya waktu untuk melihat koleksi dan penjara bawah tanah.</p></details><details><summary>Apakah tersedia parkir, toilet, dan tempat makan?<span>+</span></summary><p>Ketersediaan parkir serta toilet dapat berubah mengikuti pengaturan kawasan. Di sekeliling Kota Tua tersedia pilihan kategori makan, kebutuhan ringan, dan layanan perjalanan tanpa rekomendasi merek.</p></details></div>
      </section>

